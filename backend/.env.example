# Environment
NODE_ENV=development
PORT=4000

# Database — Railway PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_64_byte_hex
JWT_REFRESH_SECRET=CHANGE_ME_generate_64_byte_hex_different

# JWT Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Resend (email service) — get key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# App
APP_NAME=Money Moves
FRONTEND_URL=http://localhost:8081

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# Google Gemini (OCR for scanning account numbers from images)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NEAR Intents 1Click API JWT — for cross-chain deposits (BTC, TRX-USDT etc -> USDCx on Movement)
# Sign up free at https://partners.near-intents.org/home
NEAR_INTENTS_JWT=
