# Money Moves Business API - copy to .env (git ignores it) and fill in.
# On Railway, the same names go in the service's Variables. Never commit real values.
#
# This service has its OWN database. Never point DATABASE_URL at the
# Money Moves app's database - the two are kept apart on purpose.

# development | staging | production
APP_ENV=development
PORT=4100

# The business database (a fresh Postgres - local, or the environment's own on Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_moves_business

# Where the dashboard runs. Requests that change anything must come from one of these.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Set in staging/production so the session cookie covers the business subdomains, e.g. .usemoneymoves.xyz
COOKIE_DOMAIN=

# A long random string (at least 32 characters). Sign-in codes are stored only as a keyed hash of it.
CODE_PEPPER=change-me-to-a-long-random-string-of-at-least-32-chars

# Shared with the dashboard's proxy only (its PROXY_SECRET), so the API can trust the visitor address it passes on.
PROXY_SECRET=

# Encrypts uploaded documents and BVNs: 32 random bytes, base64. Required outside development.
# DOCS_KEYS_OLD keeps older keys (comma-separated) so files they sealed still open after a change.
DOCS_KEY=
DOCS_KEYS_OLD=

# Email (Resend). Without a key, development prints codes to the console instead; staging and production refuse to start.
RESEND_API_KEY=
EMAIL_FROM=Money Moves Business <noreply@usemoneymoves.xyz>

# Google sign-in: the OAuth client ID of the dashboard's Google button. Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=

# The Money Moves app's backend: the admin console signs in there, and linking a Money Moves account
# is signed with BUSINESS_LINK_SECRET (the same value the app's backend has).
APP_API_URL=https://backend-production-6f042.up.railway.app
BUSINESS_LINK_SECRET=

# The second lock on admin actions (verify, deactivate, fees, moving a settlement by hand).
# Make it with: npm run action-password-hash
ADMIN_ACTION_PASSWORD_HASH=

# The naira rate: the Money Moves app's public rates, so both quote the same number.
RATES_URL=https://backend-production-6f042.up.railway.app/api/rates

# ─── Identity checks (never simulated) ───
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=

# ─── Naira: Flutterwave v4, the same account as the app ───
# What live naira payments run on: simulated (no real money - development and staging), off, or flutterwave.
# Unset: simulated outside production, off in production. Test mode always uses the simulator.
NAIRA_RAILS=
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
# Sandbox by default. Live: the same value as FLUTTERWAVE_BASE_URL on the app's backend.
FLUTTERWAVE_BASE_URL=
# The company named on payouts.
FLUTTERWAVE_SENDER_NAME=Movers Digital Technologies Ltd
# One-time accounts are issued under the business's own accepted BVN, or this company identity when it has none.
# One of the two is enough. 11 digits.
FLUTTERWAVE_COLLECTIONS_BVN=
FLUTTERWAVE_COLLECTIONS_NIN=

# ─── On-chain: business wallets, stablecoin payments and the USDC float ───
# All optional: each part stays off until its values are set.

# Business wallets are the owner's own (they sign in and approve payouts in the dashboard) - a Dynamic
# environment of their own, not the app's. The dashboard needs the same ID as VITE_DYNAMIC_ENVIRONMENT_ID.
DYNAMIC_ENVIRONMENT_ID=

# Gas, as the app pays it: Shinami (Movement), a Solana fee payer, an EVM sponsor (Arc pays its own way).
SHINAMI_ACCESS_KEY=
SOLANA_GASLESS_PRIVATE_KEY=
EVM_GAS_SPONSOR_PRIVATE_KEY=

# Network connections.
MOVEMENT_RPC_URL=
MOVEMENT_INDEXER_URL=
SOLANA_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
ARB_RPC_URL=
ARC_RPC_URL=
MONAD_RPC_URL=
ETHEREUM_RPC_URL=
OPTIMISM_RPC_URL=
TONAPI_BASE_URL=
TONAPI_KEY=
STELLAR_HORIZON_URL=
STELLAR_RPC_URL=

# Where customers' stablecoin payments are collected (addresses only).
TREASURY_EVM_ADDRESS=
TREASURY_MOVEMENT_ADDRESS=
TREASURY_SOLANA_ADDRESS=
TREASURY_TON_ADDRESS=
TREASURY_STELLAR_ADDRESS=

# The USDC float businesses are paid from, on each settle chain (Arc and Monad share the EVM key).
FLOAT_MOVEMENT_PRIVATE_KEY=
FLOAT_SOLANA_PRIVATE_KEY=
FLOAT_EVM_PRIVATE_KEY=

# The background worker (payment checks, settlements) runs in this process unless this is "false".
RUN_WORKER=true
