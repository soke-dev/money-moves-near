# What EAS Build uploads.
#
# When this file exists EAS reads it INSTEAD of .gitignore, so it has to
# repeat the exclusions .gitignore makes rather than add to them. It exists
# because .gitignore alone was not keeping the Firebase service account key
# out of the upload - verified with `eas build:inspect --stage archive`.

node_modules/
.git/
.expo/
.vscode/
.claude/
dist/
web-build/
*.tsbuildinfo
.metro-health-check*

# Regenerated by prebuild on the builder. A local copy carries whatever
# app.json looked like the day it was generated.
android/
ios/

# Not part of the app bundle.
backend/
web/
docs/
contracts/
scripts/
public/

# Secrets. The FCM key lives in EAS credentials; signing material is managed
# by EAS. None of it belongs in a project upload.
*firebase-adminsdk*.json
firebase-service-account*.json
google-service-account*.json
.env
.env.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.pem

# Local scratch
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
tmp-*
